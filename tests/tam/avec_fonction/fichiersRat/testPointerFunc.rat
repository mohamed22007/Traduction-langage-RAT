int swap (int * a, int * b) {
    int temp = (*a);
    (*a) = (*b);
    (*b) = temp;
    return 0;
}

int * create (int val) {
    int * p = (new int);
    (*p) = val;
    return p;
}

int * getNull () {
    return null;
}

main {
    int x = 10;
    int y = 20;
    int poubelle = swap(&x, &y);
    print x;
    print y;
    int * res = create(99);
    print (*res);
    int * n = getNull();
    if (n = null) {
        print 1;
    } else {
        print 0;
    }
}